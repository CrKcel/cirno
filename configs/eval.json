{
  "sets": {
    "knowledge": "evals/knowledge.jsonl",
    "persona": "evals/persona.jsonl",
    "imform": "evals/imform.jsonl",
    "roleplay": "evals/roleplay.jsonl"
  },
  "sampling": {
    "knowledge": {"samples": 1, "temperature": 0.0, "top_k": 40, "max_new_tokens": 48},
    "persona":   {"samples": 3, "temperature": 0.7, "top_k": 40, "max_new_tokens": 48},
    "imform":    {"samples": 1, "temperature": 0.7, "top_k": 40, "max_new_tokens": 64},
    "roleplay":  {"samples": 2, "temperature": 0.7, "top_k": 40, "max_new_tokens": 64}
  },
  "prior": "runs/eval/imform_prior.json",
  "gates": {
    "imform.tone_rate": {"max": 0.02, "note": "markdown/service formulas are the negative asset of doc/training.md 4.1"},
    "imform.self_reference_rate": {"max": 0.02, "note": "the model is a chat partner, not an assistant"},
    "imform.empty_rate": {"max": 0.01},
    "persona.self_reference_rate": {"max": 0.02}
  }
}
